{
  "name": "codescope",
  "version": "3.0.0",
  "private": true,
  "productName": "CodeScope",
  "description": "码境 CodeScope：面向代码阅读、编辑、运行、文档与远程开发的工程工作台",
  "allowScripts": [
    "@deepseek-ai/dsh-subprocess-local",
    "koffi",
    "node-pty",
    "@google/genai",
    "protobufjs"
  ],
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "web": "node server.js",
    "prestart": "node scripts/ensure-onlyoffice.js",
    "preweb": "node scripts/ensure-onlyoffice.js",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "package:desktop": "electron-forge package",
    "make:desktop": "electron-forge make",
    "publish:desktop": "electron-forge publish",
    "prepackage:desktop": "npm run build:assets && npm run verify:office",
    "premake:desktop": "npm run build:assets && npm run verify:office",
    "prepublish:desktop": "npm run build:assets && npm run verify:office",
    "prepare:gopls": "node scripts/build-bundled-gopls.js",
    "verify:office": "node scripts/verify-office-package.js",
    "test": "node tests/mime.js && node tests/imap-search.js && node tests/mail-list.js && node tests/workflow.js && node tests/expr.js && node tests/flow-schedule.js && node tests/hot.js && node tests/en-text.js && node tests/en-sources.js && node tests/srs.js && node tests/mail-failfast.js && node tests/file-atlas-core.js && node tests/file-atlas-catalog.js && node tests/smoke.js && node tests/platform-sim.js",
    "test:browser": "node tests/browser-smoke.js",
    "test:run": "node tests/run.js",
    "test:blockly": "node tests/blockly-ifelse.js",
    "build:reading-editor": "node scripts/build-reading-editor.js",
    "build:study-workspace": "node scripts/build-study-workspace.js",
    "build:assets": "npm run build:reading-editor && npm run build:study-workspace && npm run build:system-panel",
    "build:system-panel": "node scripts/build-system-panel.js",
    "build:knowledge": "node scripts/build-knowledge.js",
    "test:smoke": "node tests/smoke.js",
    "test:platform": "node tests/platform-sim.js",
    "test:mime": "node tests/mime.js",
    "test:mail": "node tests/mail-failfast.js",
    "test:imap": "node tests/imap-search.js",
    "test:list": "node tests/mail-list.js",
    "test:flow": "node tests/workflow.js",
    "test:hot": "node tests/hot.js",
    "test:en": "node tests/en-text.js",
    "test:srs": "node tests/srs.js",
    "test:atlas": "node tests/file-atlas-view.js",
    "test:atlas-core": "node tests/file-atlas-core.js",
    "test:atlas-catalog": "node tests/file-atlas-catalog.js",
    "test:expr": "node tests/expr.js",
    "test:flow-sched": "node tests/flow-schedule.js",
    "test:en-src": "node tests/en-sources.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "^0.16.7",
    "@deepseek-ai/dsh": "^0.1.7-rc.1",
    "@milkdown/crepe": "^7.22.1",
    "@novnc/novnc": "^1.7.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "fflate": "^0.8.3",
    "golden-layout": "^2.6.0",
    "mammoth": "^1.12.3",
    "mind-elixir": "5.15.1",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^4.10.38",
    "pptx-preview": "^1.0.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "^0.19.0",
    "pyright": "^1.1.414",
    "saxes": "^6.0.0",
    "simple-mind-map": "0.14.0-fix.3",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.0",
    "vitepress": "^1.6.4",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xmind-embed-viewer": "1.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "electron": "^44.3.0",
    "esbuild": "^0.25.9",
    "playwright-core": "^1.63.0"
  }
}
