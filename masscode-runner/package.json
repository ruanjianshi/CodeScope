{
  "name": "codescope",
  "version": "2.3.3",
  "private": true,
  "productName": "CodeScope",
  "description": "码境 CodeScope：面向代码阅读、编辑、运行、文档与远程开发的工程工作台",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "web": "node server.js",
    "prestart": "node scripts/ensure-onlyoffice.js",
    "preweb": "node scripts/ensure-onlyoffice.js",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "package:desktop": "electron-forge package",
    "make:desktop": "electron-forge make",
    "publish:desktop": "electron-forge publish",
    "prepackage:desktop": "npm run build:reading-editor && npm run verify:office",
    "premake:desktop": "npm run build:reading-editor && npm run verify:office",
    "prepublish:desktop": "npm run build:reading-editor && npm run verify:office",
    "prepare:gopls": "node scripts/build-bundled-gopls.js",
    "verify:office": "node scripts/verify-office-package.js",
    "test": "node tests/smoke.js",
    "test:browser": "node tests/browser-smoke.js",
    "test:run": "node tests/run.js",
    "build:reading-editor": "node scripts/build-reading-editor.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "^0.16.7",
    "@milkdown/crepe": "^7.22.1",
    "@novnc/novnc": "^1.7.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.3",
    "mind-elixir": "5.15.1",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^4.10.38",
    "pptx-preview": "^1.0.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "^0.19.0",
    "pyright": "^1.1.414",
    "saxes": "^6.0.0",
    "simple-mind-map": "0.14.0-fix.3",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.0",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xmind-embed-viewer": "1.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "electron": "^44.3.0",
    "esbuild": "^0.25.9",
    "playwright-core": "^1.63.0"
  }
}
