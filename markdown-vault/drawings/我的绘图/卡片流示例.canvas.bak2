"topic\":\"New Node\",\"id\":\"173a9726955103b0\"}]},{\"topic\":\"New Node\",\"id\":\"173a330479839d0b\"}]}]},\"arrows\":[],\"summaries\":[],\"direction\":1,\"theme\":{\"name\":\"codescope\",\"type\":\"dark\",\"palette\":[\"#7dd3fc\",\"#a78bfa\",\"#34d399\",\"#fbbf24\",\"#fb7185\",\"#60a5fa\"],\"cssVar\":{\"--main-color\":\"#dbe4f0\",\"--main-bgcolor\":\"#1e2531\",\"--color\":\"#c9d2de\",\"--bgcolor\":\"#15171c\",\"--selected\":\"#5b93ff\",\"--accent-color\":\"#5b93ff\",\"--root-color\":\"#ffffff\",\"--root-bgcolor\":\"#3d4f6b\",\"--root-border-color\":\"#5b93ff\",\"--panel-color\":\"#c9d2de\",\"--panel-bgcolor\":\"#1e2531\",\"--panel-border-color\":\"#5b93ff\",\"--topic-padding\":\"6px 11px\",\"--main-radius\":\"10px\",\"--root-radius\":\"13px\",\"--node-gap-x\":\"30px\",\"--node-gap-y\":\"9px\",\"--main-gap-x\":\"56px\",\"--main-gap-y\":\"22px\",\"--map-padding\":\"26px 34px\"}},\"compact\":false}"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"aAk5A","typeName":"shape"},"shape:JXTe4SOYu7GzYVTIhxr9N":{"x":708.048798462934,"y":438,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:JXTe4SOYu7GzYVTIhxr9N","type":"pdfcard","props":{"w":600,"h":450,"title":"ALL_IN_ONE_COMMON_V4.pdf","pages":"/api/drawings/asset?f=945c71e30594e37336658bff.png\n/api/drawings/asset?f=abb915b85b3b7b86093ca545.png\n/api/drawings/asset?f=b50d822d7c8d25a727327813.png","page":0,"zoom":1},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a7HwX","typeName":"shape"},"shape:Bz3sY_3eIC3XyuYlIFRXj":{"x":1580,"y":238,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Bz3sY_3eIC3XyuYlIFRXj","type":"arrow","props":{"kind":"elbow","elbowMidPoint":0.5,"dash":"draw","size":"m","fill":"none","color":"blue","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":60,"y":0},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a6GRb","typeName":"shape"},"shape:PHm3s7N3PuCDJXJY6BqvE":{"x":840,"y":88,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:PHm3s7N3PuCDJXJY6BqvE","type":"card","props":{"w":340,"h":300,"markdown":"# 3. 找反例\n\n读完一节，自己造一个**反例**。\n\n```text\n如果作者说\"所有 A 都是 B\"，\n找一个 A 但不是 B 的东西。\n```\n\n找得到 → 这个结论有**边界**。\n找不到 → 才值得记下来。","color":"blue"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a3AJj","typeName":"shape"},"user:z76Oored6nuVjBIYSp8ig":{"name":"","color":"#F04F88","imageUrl":"","meta":{},"id":"user:z76Oored6nuVjBIYSp8ig","typeName":"user"},"shape:yXeLg6GNKaP9X0SWjBwWz":{"x":440,"y":88,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:yXeLg6GNKaP9X0SWjBwWz","type":"card","props":{"w":340,"h":300,"markdown":"# 2. 抓核心命题\n\n每章找出**一句话**能概括的命题。\n\n| 层次 | 要问的 |\n|---|---|\n| 事实 | 他说了什么 |\n| 论证 | 凭什么这么说 |\n| 前提 | 哪些是**默认成立**的 |\n\n前提站不住，论证再漂亮也没用。","color":"violet"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a2cUY","typeName":"shape"},"shape:XPhPP6YvYab__LaEYOcOF":{"x":40,"y":438,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:XPhPP6YvYab__LaEYOcOF","type":"subboard","props":{"w":650,"h":450,"title":"子白板 1","pageId":"page:VpD_l9NtqxH_C6Bqve1cI"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a9z3zV","typeName":"shape"},"binding:2CnHVkf3JOEiOG-CEg9Cx":{"meta":{},"id":"binding:2CnHVkf3JOEiOG-CEg9Cx","type":"arrow","fromId":"shape:oViLM4DDvjK5V6Dem5JHb","toId":"shape:yXeLg6GNKaP9X0SWjBwWz","props":{"isPrecise":false,"isExact":false,"normalizedAnchor":{"x":0.5,"y":0.5},"snap":"center","terminal":"end"},"typeName":"binding"},"user:pC-tviaX4V0sPxQ44Mm5w":{"name":"","color":"#11B3A3","imageUrl":"","meta":{},"id":"user:pC-tviaX4V0sPxQ44Mm5w","typeName":"user"},"shape:oViLM4DDvjK5V6Dem5JHb":{"x":380,"y":238,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:oViLM4DDvjK5V6Dem5JHb","type":"arrow","props":{"kind":"elbow","elbowMidPoint":0.5,"dash":"draw","size":"m","fill":"none","color":"blue","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":60,"y":0},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a2vrhV","typeName":"shape"},"user:jvygRa3hJv6awMewGSSx1":{"name":"","color":"#E34BA9","imageUrl":"","meta":{},"id":"user:jvygRa3hJv6awMewGSSx1","typeName":"user"},"page:VpD_l9NtqxH_C6Bqve1cI":{"meta":{"parentId":"page:page"},"id":"page:VpD_l9NtqxH_C6Bqve1cI","name":"子白板 1","index":"a2AZ2","typeName":"page"},"binding:TctLPvYV3NnykoS3HDVot":{"meta":{},"id":"binding:TctLPvYV3NnykoS3HDVot","type":"arrow","fromId":"shape:Bz3sY_3eIC3XyuYlIFRXj","toId":"shape:mkF_ObavxK0dEnYHnMAcw","props":{"isPrecise":false,"isExact":false,"normalizedAnchor":{"x":0.5,"y":0.5},"snap":"center","terminal":"end"},"typeName":"binding"},"shape:bA1ZBZRPKUORiQA2T9XT5":{"x":1308.048798462934,"y":438,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:bA1ZBZRPKUORiQA2T9XT5","type":"webcard","props":{"w":900,"h":620,"url":"https://www.bilibili.com/video/BV1rna76eEXb/?trackid=web_pegasus_0.router-web-pegasus-2479516-f6fct.1792935383765.331&spm_id_from=333.1007.tianma.1-1-1.click&vd_source=f412fc178503cd4cd82f9c512d4f458d","title":"www.bilibili.com"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a8jeU","typeName":"shape"},"user:vrPeJN_UkeQBMJ8yMsWBk":{"name":"","color":"#9D5BD2","imageUrl":"","meta":{},"id":"user:vrPeJN_UkeQBMJ8yMsWBk","typeName":"user"},"shape:-G4SP22nKj0MLnnwzonWM":{"x":0,"y":-90,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:-G4SP22nKj0MLnnwzonWM","type":"frame","props":{"w":2248,"h":1581,"name":"读书卡片流","color":"grey"},"parentId":"page:page","index":"a7VIz","typeName":"shape"},"shape:QVHV_XBiZisjW9F8Uj4Vu":{"x":40,"y":88,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:QVHV_XBiZisjW9F8Uj4Vu","type":"card","props":{"w":340,"h":300,"markdown":"# 1. 先看目录\n\n别急着翻正文。目录是作者的**论证骨架**。\n\n- 记下章节之间的**递进关系**\n- 标出三个\"看起来最重要\"的标题\n- 问一句：**作者想解决什么问题？**\n\n> 一本书通常只讲一件事，其余都是它的支撑。","color":"orange"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a1","typeName":"shape"},"page:page":{"meta":{},"id":"page:page","name":"Page 1","index":"a1","typeName":"page"},"document:document":{"gridSize":10,"name":"","meta":{},"id":"document:document","typeName":"document"},"shape:n_dDD5zh2USDqoUGzeM4z":{"x":1240,"y":88,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:n_dDD5zh2USDqoUGzeM4z","type":"card","props":{"w":340,"h":300,"markdown":"# 4. 写自己的话\n\n**不要摘抄。** 摘抄是搬运，不是理解。\n\n- 合上书，用自己的话写三行\n- 写不出来 = 没读懂，回去重读\n- 写完再对照原文，看漏了什么\n\n> 能讲给别人听，才算读完。","color":"green"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a4xH6","typeName":"shape"},"shape:V9Buh_bkUatc0XLZYr3I-":{"x":1180,"y":238,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:V9Buh_bkUatc0XLZYr3I-","type":"arrow","props":{"kind":"elbow","elbowMidPoint":0.5,"dash":"draw","size":"m","fill":"none","color":"blue","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":60,"y":0},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a4z8mX","typeName":"shape"},"shape:mkF_ObavxK0dEnYHnMAcw":{"x":1640,"y":88,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:mkF_ObavxK0dEnYHnMAcw","type":"card","props":{"w":340,"h":300,"markdown":"# 5. 连到已有知识\n\n新卡片必须**挂**到旧卡片上。\n\n1. 它推翻了我原来的哪个想法？\n2. 它补上了我哪个空白？\n3. 它和哪本书说的是同一件事？\n\n孤立的知识点会忘，**连起来**的不会。","color":"red"},"parentId":"shape:-G4SP22nKj0MLnnwzonWM","index":"a54l2","typeName":"shape"}},"schema":{"schemaVersion":2,"sequences":{"com.tldraw.store":5,"com.tldraw.asset":1,"com.tldraw.camera":1,"com.tldraw.document":2,"com.tldraw.instance":26,"com.tldraw.instance_page_state":5,"com.tldraw.page":1,"com.tldraw.instance_presence":6,"com.tldraw.pointer":1,"com.tldraw.shape":4,"com.tldraw.user":1,"com.tldraw.asset.image":6,"com.tldraw.asset.video":5,"com.tldraw.asset.bookmark":2,"com.tldraw.shape.group":0,"com.tldraw.shape.text":4,"com.tldraw.shape.bookmark":2,"com.tldraw.shape.draw":5,"com.tldraw.shape.geo":12,"com.tldraw.shape.note":13,"com.tldraw.shape.line":5,"com.tldraw.shape.frame":1,"com.tldraw.shape.arrow":8,"com.tldraw.shape.highlight":4,"com.tldraw.shape.embed":4,"com.tldraw.shape.image":5,"com.tldraw.shape.video":4,"com.tldraw.shape.subboard":0,"com.tldraw.shape.webcard":0,"com.tldraw.shape.card":0,"com.tldraw.shape.sticky":0,"com.tldraw.shape.pdfcard":0,"com.tldraw.shape.mnode":0,"com.tldraw.shape.mindcard":0,"com.tldraw.binding.arrow":1}}},"session":{"version":0,"currentPageId":"page:page","exportBackground":true,"isFocusMode":false,"isDebugMode":false,"isToolLocked":false,"isGridMode":true,"pageStates":[{"pageId":"page:page","camera":{"x":401.81467542356023,"y":239.88454779322802,"z":0.6676977019767697},"selectedShapeIds":["shape:JXTe4SOYu7GzYVTIhxr9N"],"focusedGroupId":null},{"pageId":"page:VpD_l9NtqxH_C6Bqve1cI","camera":{"x":0,"y":0,"z":1},"selectedShapeIds":[],"focusedGroupId":null}]}}