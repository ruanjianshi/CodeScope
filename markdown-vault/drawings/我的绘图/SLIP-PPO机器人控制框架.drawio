  <diagram id="slip-ppo-control" name="控制框架">
    <mxGraphModel dx="2325" dy="1648" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" value="扩展 SLIP–PPO 两轮足机器人控制框架" vertex="1">
          <mxGeometry height="34" width="740" x="430" y="5" as="geometry" />
        </mxCell>
        <mxCell id="feedforward-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;strokeWidth=2;strokeColor=#4A90E2;fillColor=#EAF3FF;fillOpacity=28;arcSize=6;" value="" vertex="1">
