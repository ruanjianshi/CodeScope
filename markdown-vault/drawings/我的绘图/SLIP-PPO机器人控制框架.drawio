        <mxCell id="feedforward-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#245D9B;" value="1. 扩展 SLIP 模型（前馈生成）" vertex="1">
          <mxGeometry height="28" width="350" x="245" y="65" as="geometry" />
        </mxCell>
        <mxCell id="feedback-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;strokeWidth=2;strokeColor=#3AA76D;fillColor=#ECFAF2;fillOpacity=32;arcSize=6;" value="" vertex="1">
          <mxGeometry height="510" width="705" x="835" y="55" as="geometry" />
        </mxCell>
        <mxCell id="feedback-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#237A4B;" value="2. 强化学习模块（反馈修正）" vertex="1">
          <mxGeometry height="28" width="350" x="1015" y="65" as="geometry" />
        </mxCell>
        <mxCell id="fsm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;strokeColor=#4A90E2;fillColor=#FFFFFF;fontColor=#22354A;fontSize=12;shadow=1;" value="&lt;b&gt;六状态有限状态机（FSM）&lt;/b&gt;&lt;br&gt;&lt;br&gt;−1 初始校验 → 0 站立接触&lt;br&gt;→ 1 起跳压缩 → 2 飞行相位&lt;br&gt;→ 3 落地缓冲 → 4 恢复稳定" vertex="1">
          <mxGeometry height="150" width="245" x="55" y="110" as="geometry" />
        </mxCell>
        <mxCell id="transitions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;strokeColor=#4A90E2;fillColor=#FFFFFF;fontColor=#22354A;fontSize=12;shadow=1;" value="&lt;b&gt;状态转换条件（传感器事件）&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 跳跃指令与阶段驻留时间&lt;br&gt;• 关节角度 / 速度阈值&lt;br&gt;• 质心高度与垂向速度&lt;br&gt;• 左右轮接触状态 c&lt;sub&gt;L&lt;/sub&gt;, c&lt;sub&gt;R&lt;/sub&gt;&lt;br&gt;• 超时与异常恢复" vertex="1">
          <mxGeometry height="190" width="245" x="55" y="300" as="geometry" />
        </mxCell>
        <mxCell id="dynamics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;strokeColor=#4A90E2;fillColor=#FFFFFF;fontColor=#22354A;fontSize=12;shadow=1;" value="&lt;b&gt;扩展 SLIP 动力学&lt;/b&gt;&lt;br&gt;&lt;br&gt;腿部弹簧力&lt;br&gt;F&lt;sub&gt;leg&lt;/sub&gt; = −k&lt;sub&gt;s&lt;/sub&gt;(q&lt;sub&gt;l&lt;/sub&gt; − h&lt;sub&gt;ref&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;车轮转动动力学&lt;br&gt;τ&lt;sub&gt;w&lt;/sub&gt; = I&lt;sub&gt;w&lt;/sub&gt;q̈&lt;sub&gt;w&lt;/sub&gt; + b&lt;sub&gt;w&lt;/sub&gt;q̇&lt;sub&gt;w&lt;/sub&gt;" vertex="1">
          <mxGeometry height="165" width="225" x="335" y="110" as="geometry" />
        </mxCell>
        <mxCell id="flight-profile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.5;strokeColor=#4A90E2;fillColor=#FFFFFF;fontColor=#22354A;fontSize=12;shadow=1;" value="&lt;b&gt;飞行期前馈波形提升&lt;/b&gt;&lt;br&gt;&lt;br&gt;ω&lt;sub&gt;ff&lt;/sub&gt;(t) = ω&lt;sub&gt;0&lt;/sub&gt; + Δω · s(t)" vertex="1">
          <mxGeometry height="95" width="225" x="335" y="305" as="geometry" />
        </mxCell>
        <mxCell id="feedforward-ref" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.5;strokeColor=#4A90E2;fillColor=#FFFFFF;fontColor=#22354A;fontSize=12;shadow=1;" value="&lt;b&gt;前馈参考轨迹生成&lt;/b&gt;&lt;br&gt;&lt;br&gt;q&lt;sub&gt;ff&lt;/sub&gt;(t), ω&lt;sub&gt;ff&lt;/sub&gt;(t)" vertex="1">
          <mxGeometry height="85" width="225" x="335" y="435" as="geometry" />
        </mxCell>
        <mxCell id="mapping" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;strokeColor=#4A90E2;fillColor=#FFFFFF;fontColor=#22354A;fontSize=12;shadow=1;" value="&lt;b&gt;SLIP 到关节角 / 轮速映射&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 逆运动学&lt;br&gt;q&lt;sub&gt;ref&lt;/sub&gt; = atan2(z, x) ± acos(·)&lt;br&gt;&lt;br&gt;② 轮速目标&lt;br&gt;ω&lt;sub&gt;ref&lt;/sub&gt; = v&lt;sub&gt;x&lt;/sub&gt; / r" vertex="1">
          <mxGeometry height="270" width="190" x="590" y="150" as="geometry" />
        </mxCell>
        <mxCell id="observation" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;strokeColor=#3AA76D;fillColor=#FFFFFF;fontColor=#254839;fontSize=12;shadow=1;" value="&lt;b&gt;观测向量 o&lt;sub&gt;t&lt;/sub&gt;（35 维）&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 基座姿态与角速度&lt;br&gt;• 关节位置 / 速度&lt;br&gt;• 左右轮速度&lt;br&gt;• 接触状态 c&lt;sub&gt;L&lt;/sub&gt;, c&lt;sub&gt;R&lt;/sub&gt;&lt;br&gt;• 当前 FSM 状态" vertex="1">
          <mxGeometry height="175" width="205" x="865" y="115" as="geometry" />
        </mxCell>
        <mxCell id="actor-critic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;strokeColor=#3AA76D;fillColor=#FFFFFF;fontColor=#254839;fontSize=12;shadow=1;" value="&lt;b&gt;PPO Actor–Critic 策略&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actor: 35 → 128 → 128 → 6&lt;br&gt;Critic: 35 → 128 → 128 → 1&lt;br&gt;&lt;br&gt;π&lt;sub&gt;θ&lt;/sub&gt;(a&lt;sub&gt;t&lt;/sub&gt; | o&lt;sub&gt;t&lt;/sub&gt;), V&lt;sub&gt;φ&lt;/sub&gt;(o&lt;sub&gt;t&lt;/sub&gt;)" vertex="1">
          <mxGeometry height="175" width="205" x="1100" y="115" as="geometry" />
        </mxCell>
        <mxCell id="action" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=9;strokeWidth=1.5;strokeColor=#3AA76D;fillColor=#FFFFFF;fontColor=#254839;fontSize=12;shadow=1;" value="&lt;b&gt;反馈动作修正 Δa&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Δa&lt;sub&gt;t&lt;/sub&gt; = [Δq&lt;sub&gt;leg&lt;/sub&gt;, Δω&lt;sub&gt;wheel&lt;/sub&gt;]&lt;br&gt;&lt;br&gt;4 个关节位置&lt;br&gt;2 个轮速修正量" vertex="1">
          <mxGeometry height="175" width="175" x="1335" y="115" as="geometry" />
        </mxCell>
        <mxCell id="reward" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;strokeColor=#3AA76D;fillColor=#FFFFFF;fontColor=#254839;fontSize=12;shadow=1;" value="&lt;b&gt;奖励函数 R&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;R&lt;sub&gt;t&lt;/sub&gt; = w&lt;sub&gt;v&lt;/sub&gt;r&lt;sub&gt;v&lt;/sub&gt; + w&lt;sub&gt;p&lt;/sub&gt;r&lt;sub&gt;pose&lt;/sub&gt;&lt;br&gt;+ w&lt;sub&gt;f&lt;/sub&gt;r&lt;sub&gt;feet&lt;/sub&gt; + w&lt;sub&gt;s&lt;/sub&gt;r&lt;sub&gt;smooth&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;轮速误差惩罚&lt;br&gt;r&lt;sub&gt;wheel&lt;/sub&gt; = −|ω&lt;sub&gt;R&lt;/sub&gt;−ω&lt;sub&gt;cmd&lt;/sub&gt;|&lt;/font&gt;" vertex="1">
          <mxGeometry height="175" width="255" x="1075" y="340" as="geometry" />
        </mxCell>
        <mxCell id="curriculum" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=1.5;strokeColor=#3AA76D;fillColor=#FFFFFF;fontColor=#254839;fontSize=12;shadow=1;" value="&lt;b&gt;分阶段奖励权重调度&lt;/b&gt;&lt;br&gt;&lt;br&gt;早期：姿态稳定 + 轮速跟踪&lt;br&gt;中期：速度跟踪 + 双足同步&lt;br&gt;晚期：落地稳定 + 能耗约束&lt;br&gt;&lt;br&gt;自动课程化难度递进" vertex="1">
          <mxGeometry height="175" width="150" x="1360" y="340" as="geometry" />
        </mxCell>
        <mxCell id="fusion" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;strokeColor=#8B5CF6;fillColor=#F5F0FF;fontColor=#5B3AA8;fontSize=14;shadow=1;" value="&lt;b&gt;加权融合&lt;/b&gt;&lt;br&gt;a&lt;sub&gt;t&lt;/sub&gt; = a&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;ff&lt;/sup&gt; + α&lt;sub&gt;t&lt;/sub&gt;Δa&lt;sub&gt;t&lt;/sub&gt;" vertex="1">
          <mxGeometry height="75" width="280" x="660" y="610" as="geometry" />
