        <mxCell id="pd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;strokeColor=#8B5CF6;fillColor=#FFFFFF;fontColor=#4C367A;fontSize=13;shadow=1;" value="&lt;b&gt;PD 控制器&lt;/b&gt;&lt;br&gt;τ&lt;sub&gt;t&lt;/sub&gt; = K&lt;sub&gt;p&lt;/sub&gt;(a&lt;sub&gt;ref&lt;/sub&gt;−a&lt;sub&gt;t&lt;/sub&gt;) + K&lt;sub&gt;d&lt;/sub&gt;(ȧ&lt;sub&gt;ref&lt;/sub&gt;−ȧ&lt;sub&gt;t&lt;/sub&gt;)" vertex="1">
